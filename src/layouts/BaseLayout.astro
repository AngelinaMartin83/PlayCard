---
import "../styles/global.css";
import type { AlternateLink, Locale } from "../content/site";
import { localeContent, localeLabels, locales, siteDomain, siteName } from "../content/site";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternates?: AlternateLink[];
  homeHref?: string;
  localeHrefs?: Partial<Record<Locale, string>>;
};

const {
  locale,
  title,
  description,
  canonicalPath,
  alternates = [],
  homeHref = `/${locale}/`,
  localeHrefs = {}
} = Astro.props;
const currentLocaleContent = localeContent[locale];
const site = Astro.site ?? new URL("https://klondike-solitaire.xyz/");
const canonicalUrl = new URL(canonicalPath, site).toString();
---

<!doctype html>
<html lang={currentLocaleContent.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/playcard-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/playcard-mark.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={new URL(alternate.path, site).toString()}
      />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={homeHref} aria-label={siteName}>
          <img class="brand-mark" src="/playcard-mark.svg" alt="" width="44" height="44" />
          <span class="brand-copy">
            <span class="brand-name">{siteName}</span>
            <span class="brand-domain">{siteDomain}</span>
          </span>
        </a>
        <nav class="locale-nav" aria-label={currentLocaleContent.switchLabel}>
          {locales.map((item) => (
            <a
              class:list={["locale-link", { active: item === locale }]}
              href={localeHrefs[item] ?? (canonicalPath === `/${locale}/`
                ? `/${item}/`
                : canonicalPath.replace(`/${locale}/`, `/${item}/`))}
            >
              {localeLabels[item]}
            </a>
          ))}
        </nav>
      </header>
      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>
