---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildAlternates, localeContent, normalizeLocale } from "../../content/site";

export function getStaticPaths() {
  return [{ params: { locale: "zh" } }, { params: { locale: "en" } }];
}

const locale = normalizeLocale(Astro.params.locale);
const content = localeContent[locale];
const canonicalPath = `/${locale}/`;
const alternates = buildAlternates((item) => `/${item}/`);
---

<BaseLayout
  locale={locale}
  title={content.home.seo.title}
  description={content.home.seo.description}
  canonicalPath={canonicalPath}
  alternates={alternates}
>
  <section class="hero-card">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{content.home.hero.eyebrow}</p>
        <h1>{content.home.hero.title}</h1>
        <p>{content.home.hero.description}</p>
        <div class="hero-actions">
          <a class="button-link primary" href={`/${locale}/solitaire`}>
            {content.home.hero.primaryCta}
          </a>
          <a
            class="button-link secondary"
            href={locale === "zh" ? "/en/" : "/zh/"}
          >
            {content.home.hero.secondaryCta}
          </a>
        </div>
      </div>
      <aside class="hero-panel">
        <h2>{locale === "zh" ? "当前骨架包含" : "What is included now"}</h2>
        <p>
          {locale === "zh"
            ? "多语言路径、SEO 页面壳、游戏嵌入和后续扩展所需的基础目录都已经准备好了。"
            : "Localized routes, an SEO-ready page shell, the embedded game module, and the base folders for future expansion are all in place."}
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
