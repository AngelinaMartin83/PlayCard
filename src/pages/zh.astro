---
import SolitairePageContent from "../components/SolitairePageContent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localeContent } from "../content/site";

const locale = "zh";
const content = localeContent.zh.solitaire;
---

<BaseLayout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  canonicalPath="/zh"
  homeHref="/"
  localeHrefs={{ en: "/", zh: "/zh" }}
  alternates={[
    { hreflang: "en", path: "/" },
    { hreflang: "zh", path: "/zh" },
    { hreflang: "x-default", path: "/" }
  ]}
>
  <SolitairePageContent locale={locale} />
</BaseLayout>
